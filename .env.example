# Impostare una password forte e casuale prima dell'avvio.
GE360_APP_PASSWORD=SOSTITUISCI_CON_UNA_PASSWORD_LUNGA_E_UNICA
# Cookie Secure: lascia 1 quando usi HTTPS con Tailscale Serve
GE360_COOKIE_SECURE=1
# Segreto per firmare la sessione: generare con: openssl rand -hex 32
GE360_SESSION_SECRET=SOSTITUISCI_CON_64_CARATTERI_ESADACIMALI_RANDOM
GE360_DATA_DIR=/data
